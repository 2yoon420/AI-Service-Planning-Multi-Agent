# 가상환경 (용량 크고 재설치 가능 — requirements.txt로 복원)
venv/
__pycache__/
*.pyc

# 비밀키 (절대 커밋 금지)
.env

# RAG 벡터DB (재생성 가능 — rag/build_corpus.py로 복원)
rag/chroma_db/

# 테스트/디버그용 잔여 DB
fact_store/test2.db
fact_store/test2.db-journal

# LangGraph 체크포인트 DB (대화 상태 저장소 — fact_store.db와 달리 사람이 볼 만한
# 데이터가 아니라 그래프 실행 상태 스냅샷이라 rag/chroma_db와 같은 원칙으로 커밋하지 않음.
# 2026-07-24 Router+interrupt() 확장에서 추가)
orchestrator/checkpoints.db

# 렌더링 테스트로 생성된 임시 DOCX (최종 산출물이 아니라 검증용)
outputs/*.docx

# OS
.DS_Store

# API 프로젝트 메타 저장소 (자동 생성, fastapi_설계도.md 10-7절)
api/sessions.db

# FUSE 마운트 잔여물 (샌드박스 작업 부산물)
.fuse_hidden*

# Fact Store DB (2026-07-28 추적 해제)
# 배포 스크립트가 git reset --hard를 하므로, 추적 상태로 두면 배포할 때마다
# 서버에서 수집한 fact가 저장소 버전으로 덮인다. 데이터는 DATA_DIR(운영) 또는
# 로컬 파일(개발)로 관리한다 — paths.py 상단 주석 참고.
fact_store/fact_store.db
fact_store/fact_store.db.backup_*

# 프론트엔드 빌드 산출물·의존성 (2026-07-28 추가)
# node_modules는 95MB이고, deploy/deploy.sh가 서버에서 `npm ci`로 재설치한다.
# dist도 서버에서 `npm run build`로 생성하므로 커밋하지 않는다.
# 단 package-lock.json은 npm ci에 필수이므로 반드시 커밋한다.
frontend/node_modules/
frontend/dist/

# Vite가 남기는 임시 설정 파일
frontend/vite.config.ts.timestamp-*.mjs

# pytest 캐시
.pytest_cache/
fact_store/fact_snapshot.db
fact_store/kr_snapshot.db
orchestrator/checkpoints.db-wal
orchestrator/checkpoints.db-shm
eval/__pycache__/

# 서버 DB 스냅샷 (2026-07-29)
fact_store/fact_*.db
