# 이 파일을 복사해서 .env로 이름을 바꾸고, 실제 키 값을 채워 넣으세요.
# .env 파일은 절대 git에 커밋하거나 채팅에 붙여넣지 마세요.

# Google Gemini (무료 티어 - 개발/테스트용)
GOOGLE_API_KEY=

# Upstage (Solar Pro 2/3, Document Parse - 프로덕션용)
UPSTAGE_API_KEY=

# Anthropic Claude (체험판 발급 시 추가 - 현재 미보유, 추후 검증용)
ANTHROPIC_API_KEY=

# BRAVE_API_KEY는 2026-07-28에 제거했다. 키를 넣은 적이 없어 한 번도 실행되지
# 않았고, Brave가 2026년 2월부로 신규 무료 티어를 없앴다. Tavily가 그 자리를
# 대신하며 본문 추출 역할까지 함께 맡는다.

# Tavily (2026-07-28 추가) — 보조 검색 + JS 렌더링 페이지 본문 추출
#
# 없어도 파이프라인은 동작한다. 키가 비면 ddgs 단독 + 정규식 간이 추출로
# 조용히 폴백한다(agents/web_search.py의 _tavily_api_key 참고).
# 무료 티어 월 1,000크레딧: search basic 1건=1크레딧, extract basic 5건 성공=1크레딧.
TAVILY_API_KEY=

# 모델 선택 (Upstage). 미설정 시 코드 기본값 사용.
HEAVY_MODEL=
LIGHT_MODEL=
