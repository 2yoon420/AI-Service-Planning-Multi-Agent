# /etc/planner/planner.env  (권한 640, 소유자 root:planner)
#
# systemd가 EnvironmentFile로 읽는다. 따옴표를 쓰지 말 것 —
# systemd는 따옴표를 값의 일부로 넣는다.
UPSTAGE_API_KEY=
TAVILY_API_KEY=
HEAVY_MODEL=
LIGHT_MODEL=
# 검증(Reviewer) 단계 전용 채점 모델. 비워두면 solar-pro2를 쓴다.
# LIGHT_MODEL과 분리한 이유: 2026-07-28 self-test 실측에서 solar-pro2가 20/20(판정
# 뒤집힘 0건)으로 유일하게 통과했고, mini는 정상 근거를 실행마다 다르게 처리했다.
# 검증 단계만 정확한 모델로 올리고 router의 capability QA는 mini를 유지하기 위함.
VERIFICATION_MODEL=
